{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marynovaproxy09",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "54039cd9-22f2-40a2-a6cc-fb47fcc3264a","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3ebef1d7afe74c16a972c05cd95bd180" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
